[node name="Porch" parent="Shell" instance=ExtResource("c_porch")]

[node name="Door" parent="Shell" instance=ExtResource("c_door")]

[node name="Furnishings" type="Node3D" parent="."]

; 床是唯一可搬动的家具：位置与朝向由 SEA-ROOM 的布局状态拥有，
; 这里的 transform 只是初版摆放，进房间与读档时都会被 apply_layout 覆盖。
[node name="Bed" type="Node3D" parent="Furnishings"]
position = Vector3(-1.86, 0, -1.425)
script = ExtResource("bed_script")

[node name="Visual" parent="Furnishings/Bed" instance=ExtResource("c_bed")]

[node name="Nightstand" parent="Furnishings" instance=ExtResource("c_nightstand")]
position = Vector3(-0.95, 0, -2.29)

[node name="TableLamp" parent="Furnishings" instance=ExtResource("c_lamp")]
position = Vector3(-0.95, 0.5, -2.29)

[node name="Rug" parent="Furnishings" instance=ExtResource("c_rug")]
position = Vector3(0.45, 0, 0.35)

[node name="Shelf" parent="Furnishings" instance=ExtResource("c_shelf")]
position = Vector3(2.24, 0, -0.15)

; 固定陈设的遮挡：床自带遮挡（跟着床走），这两件是死的。
[node name="NightstandBlock" type="StaticBody3D" parent="Furnishings"]
position = Vector3(-0.95, 0.26, -2.29)
script = ExtResource("block")

[node name="Shape" type="CollisionShape3D" parent="Furnishings/NightstandBlock"]
shape = SubResource("Shape_nightstand")

[node name="ShelfBlock" type="StaticBody3D" parent="Furnishings"]
position = Vector3(2.24, 0.4, -0.15)
script = ExtResource("block")

[node name="Shape" type="CollisionShape3D" parent="Furnishings/ShelfBlock"]
shape = SubResource("Shape_shelf")

; 可走面：室内 + 1.1 米宽的门槛 + 玻璃前厅。门槛这一块是关键 ——
; 少了它，前厅和室内就是两个断开的矩形，人从门里走不过去。
[node name="WalkAreas" type="Node3D" parent="."]

[node name="Walk_room_floor" type="Node3D" parent="WalkAreas"]
script = ExtResource("walk")
area_id = "room_floor"
zone_id = "room"
surface_y = 200
span_min = 0.0
span_max = 3.2
rects = [Rect2(-2.42, -2.42, 4.84, 4.84), Rect2(-0.55, 2.4, 1.1, 0.34), Rect2(-1.62, 2.7, 3.24, 1.62)]

; 室内灯：都挂在 home_lamps 组，由日照装置按时段自动开关 ——
; 白天熄、入夜渐亮，和家园其它灯同一条曲线，不另造一套亮度规则。
[node name="Lights" type="Node3D" parent="."]

[node name="LampGlow" type="OmniLight3D" parent="Lights" groups=["home_lamps"]]
position = Vector3(-0.95, 0.88, -2.29)
light_color = Color(1, 0.66, 0.32, 1)
light_energy = 1.35
light_specular = 0.15
omni_range = 5.5
omni_attenuation = 0.9
shadow_enabled = true

[node name="RoomFill" type="OmniLight3D" parent="Lights" groups=["home_lamps"]]
position = Vector3(0.25, 2.3, 0.45)
light_color = Color(1, 0.93, 0.82, 1)
light_energy = 0.55
light_specular = 0.05
omni_range = 7.5
omni_attenuation = 1.0

; 剖切：相机在房顶以上时收起天花，在南侧时收起前墙。
[node name="Cutaway" type="Node3D" parent="."]
script = ExtResource("cutaway_script")

; 出门点（SEA-ROOM-R16）：前厅正面门洞上的纯逻辑交互点，没有几何 ——
; 靠近后出「[E] 离开房间」与近距图标，和屋外门口那颗「进入房间」对称。
; 摆在门外一侧（局部 z 4.25，前厅可走到 4.32），因为玩家走到房间最外沿
; 就已经想出去了；半径 1.6 米让刚进屋站在前厅里也能立刻看见。
; 只发信号，过场仍由 room_controller 走那一条；不新增任何进出通道。
[node name="ExitPoint" type="Node3D" parent="."]
position = Vector3(0, 0, 4.25)
script = ExtResource("exit_script")
