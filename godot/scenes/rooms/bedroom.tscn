; SEA-ROOM 房间：内部净空 5×5 米，木头地板、白墙、后墙一面窗，前侧一个玻璃前厅。
; 原点在室内地面中心，+Z 朝玻璃前厅；整间房摆在太阳房屋顶正上方
; (2.5, 12.6, 1.0)——比屋面最高点 11.89 米再高 0.7 米，不穿模。
; 四周墙面高度 2.75 米。走的是与海上区块相同的接口（zone_id / walk_areas），
; 所以房间里点地面走路、交互判定、存档位置校验都不需要另开通道。
[node name="Bedroom" type="Node3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 12.6, 1.0)
script = ExtResource("room_scene")
zone_id = "room"
zone_label = "房间"
water_layer = "surface"
water_layer_role = "part"

[node name="Shell" type="Node3D" parent="."]

[node name="Floor" parent="Shell" instance=ExtResource("c_floor")]

[node name="WallWindow" parent="Shell" instance=ExtResource("c_wall_window")]

