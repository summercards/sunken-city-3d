; SEA-ROOM 房间：内部净空 5×5 米（本文件按 1:1 建模），木头地板、白墙、
; 后墙一面窗，前侧一个玻璃前厅。走的是与海上区块相同的接口
; （zone_id / walk_areas），所以房间里点地面走路、交互判定、存档位置校验
; 都不需要另开通道。
;
; 两件事必须一起看：
;
; 1. **整间房 scale 1.5**。角色 SCALE（avatar_dimensions.gd）= 1.5，身高 ~1.88 米。
;    按 1:1 用时净空/身高 = 5/1.88 = 2.66，门洞只有身高的 1.1 倍 —— 挤得转不开身。
;    放大 1.5 倍后是 7.5/1.88 = 3.99、门洞 3.09/1.88 = 1.64，正好回到原设计比例
;    （原设计按 1.25 米角色：5/1.25 = 4.0、2.06/1.25 = 1.65）。
;    几何不重建，因为 Blender 资产是干净的 1:1 源；缩放只在这一处。
;
; 2. **位置 (0, 200, 0) 与太阳房无关，只为隔离**。玩家进屋后看不到外面
;    （世界全藏、背景纯黑），所以「在不在屋顶上」没有视觉意义。
;    反过来，原先的 (2.5, 12.6, 1.0) 让房间 12.6~15.35 与海鸥飞行层
;    14.3~17.7 重叠 —— 详见 docs/development/2026-11-06_room_scale_isolation.md。
[node name="Bedroom" type="Node3D"]
transform = Transform3D(1.5, 0, 0, 0, 1.5, 0, 0, 0, 1.5, 0, 200, 0)
script = ExtResource("room_scene")
zone_id = "room"
zone_label = "房间"
water_layer = "surface"
water_layer_role = "part"

[node name="Shell" type="Node3D" parent="."]

[node name="Floor" parent="Shell" instance=ExtResource("c_floor")]

[node name="WallWindow" parent="Shell" instance=ExtResource("c_wall_window")]

[node name="WallDoor" parent="Shell" instance=ExtResource("c_wall_door")]

[node name="WallEast" parent="Shell" instance=ExtResource("c_wall_east")]

[node name="WallWest" parent="Shell" instance=ExtResource("c_wall_west")]

