position = Vector3(0.45, 0, 0.35)

[node name="Shelf" parent="Furnishings" instance=ExtResource("c_shelf")]
position = Vector3(2.24, 0, -0.15)

; 固定陈设的遮挡：床自带遮挡（跟着床走），这两件是死的。
[node name="NightstandBlock" type="StaticBody3D" parent="Furnishings"]
position = Vector3(-0.95, 0.26, -2.29)
script = ExtResource("block")

[node name="Shape" type="CollisionShape3D" parent="Furnishings/NightstandBlock"]
shape = SubResource("Shape_nightstand")

[node name="ShelfBlock" type="StaticBody3D" parent="Furnishings"]
position = Vector3(2.24, 0.4, -0.15)
script = ExtResource("block")

[node name="Shape" type="CollisionShape3D" parent="Furnishings/ShelfBlock"]
shape = SubResource("Shape_shelf")

; 可走面：室内 + 1.1 米宽的门槛 + 玻璃前厅。门槛这一块是关键 ——
; 少了它，前厅和室内就是两个断开的矩形，人从门里走不过去。
[node name="WalkAreas" type="Node3D" parent="."]

[node name="Walk_room_floor" type="Node3D" parent="WalkAreas"]
script = ExtResource("walk")
area_id = "room_floor"
zone_id = "room"
surface_y = 12.6
span_min = 0.0
span_max = 3.2
rects = [Rect2(-2.42, -2.42, 4.84, 4.84), Rect2(-0.55, 2.4, 1.1, 0.34), Rect2(-1.62, 2.7, 3.24, 1.62)]

; 室内灯：都挂在 home_lamps 组，由日照装置按时段自动开关 ——
; 白天熄、入夜渐亮，和家园其它灯同一条曲线，不另造一套亮度规则。
[node name="Lights" type="Node3D" parent="."]

[node name="LampGlow" type="OmniLight3D" parent="Lights" groups=["home_lamps"]]
position = Vector3(-0.95, 0.88, -2.29)
light_color = Color(1, 0.66, 0.32, 1)
light_energy = 1.35
light_specular = 0.15
omni_range = 5.5
omni_attenuation = 0.9
shadow_enabled = true

[node name="RoomFill" type="OmniLight3D" parent="Lights" groups=["home_lamps"]]
position = Vector3(0.25, 2.3, 0.45)
