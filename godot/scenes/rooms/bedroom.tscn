[node name="Porch" parent="Shell" instance=ExtResource("c_porch")]

[node name="Door" parent="Shell" instance=ExtResource("c_door")]

[node name="Furnishings" type="Node3D" parent="."]

; 床是唯一可搬动的家具：位置与朝向由 SEA-ROOM 的布局状态拥有，
; 这里的 transform 只是初版摆放，进房间与读档时都会被 apply_layout 覆盖。
[node name="Bed" type="Node3D" parent="Furnishings"]
position = Vector3(-1.86, 0, -1.425)
script = ExtResource("bed_script")

[node name="Visual" parent="Furnishings/Bed" instance=ExtResource("c_bed")]

[node name="Nightstand" parent="Furnishings" instance=ExtResource("c_nightstand")]
