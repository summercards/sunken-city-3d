  "relationships":[
    {"id":"edge_route_seed","from":"npc_luo_yan","to":"npc_mu_he","type":"旧日同伴","base":65,"summary":"船老大帮豆豆运种子，豆豆替出船的人备菜。","history":"搬来前就合运过菜种，遇雨时一起护住了种子箱。","tension":"船上位置不够时，一个急着装修船料，一个担心种子受潮。","reconcile":"提前列好件数和防潮办法，把种子箱与工具分开装。"},
    {"id":"edge_route_echo","from":"npc_luo_yan","to":"npc_ji_chen","type":"前搭档","base":-35,"summary":"船老大和阿海以前同船干活，如今说话不太自在。","history":"一次打捞中返航信号没对上，两人回来后没把经过说清。","tension":"一个以为搭档不再信任自己，一个怕承认漏看信号。","reconcile":"各自写下当时的潮位和信号，面对面核对，再定返航办法。"},
    {"id":"edge_route_joint","from":"npc_luo_yan","to":"npc_nan_zhi","type":"工作伙伴","base":20,"summary":"船老大找木头叔修船板，两人常为工期拌嘴。","history":"木头叔给送货船换过踏板，船老大帮他运长木料。","tension":"船老大想早点出船，木头叔坚持量准、试稳再交工。","reconcile":"先约定检修时段，急用的踏板先做，其余逐项验收。"},
    {"id":"edge_seed_joint","from":"npc_mu_he","to":"npc_nan_zhi","type":"共事伙伴","base":55,"summary":"豆豆管苗，木头叔帮她修苗床和挡风板。","history":"两人一起把旧木箱改成育苗箱，按浇水习惯调过高度。","tension":"苗床想加宽，走道和工具又没有足够地方放。","reconcile":"拿空箱先试摆，留出提水和推车的路再落锯。"},
    {"id":"edge_seed_lamp","from":"npc_mu_he","to":"npc_bai_shi","type":"记忆传承","base":35,"summary":"豆豆请灯伯认旧标签，灯伯帮她查种子名册。","history":"旧种子袋有水渍，两人一袋袋对照旧本子。","tension":"豆豆想尽快写名，灯伯怕认错字让人种错品种。","reconcile":"看不清的先标未知，播小盆作对照，把新结果补进账本。"},
    {"id":"edge_echo_lamp","from":"npc_ji_chen","to":"npc_bai_shi","type":"隐瞒与追问","base":-20,"summary":"灯伯想补齐日志，阿海一直不愿讲漏掉的那段。","history":"阿海把旧日志交来保管，返航那页却缺了自己的记录。","tension":"阿海怕被责怪，灯伯问得越细，他越想躲。","reconcile":"先注明未核对，让阿海按自己记得的写，再请当事人补充。"},
    {"id":"edge_joint_lamp","from":"npc_nan_zhi","to":"npc_bai_shi","type":"师徒","base":75,"summary":"木头叔跟灯伯学过手艺，现在会和师父商量改旧尺寸。","history":"灯伯教过木头叔认图、做灯架，也留给他一本旧尺寸册。","tension":"照旧图摆满长凳后，推小车的人反而进不来。","reconcile":"一起量现在的小车，给灯下留通道，把改动缘由写在图旁。"},
    {"id":"edge_seed_flower","from":"npc_mu_he","to":"npc_hua_yi","type":"种植伙伴","base":60,"summary":"豆豆和小花交换种苗，一起商量菜和花怎么分地方。","history":"小花认出豆豆没敢播的花种，两人一起做过小盆对照。","tension":"豆豆担心口粮，小花又怕花摊一直被当成多余。","reconcile":"先留一小格种花，菜的收成和花种的留种量都记清。"},
    {"id":"edge_flower_shelf","from":"npc_hua_yi","to":"npc_bao_he","type":"店铺伙伴","base":45,"summary":"小花在天台备花，托船送给东南浮店的阿店代摆。","history":"两人从空瓶和包装纸开始换货，又商量借半格摆瓶装花。","tension":"小花想把花摆近客人，阿店怕水弄湿纸袋和干货。","reconcile":"用隔水托盘，写明送货、收花和擦水的时间，各管好自己一端。"}
