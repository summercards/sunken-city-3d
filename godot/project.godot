; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="sea"
config/description="sea · Godot 版"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Zones="*res://src/world/zones.gd"
Economy="*res://src/economy/economy.gd"
GameState="*res://src/bootstrap/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/material_guard/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[rendering]

lights_and_shadows/directional_shadow/size=8192
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.09, 0.427, 0.604, 1)

[shader_globals]

world_daylight={
"type": "float",
"value": 1.0
}
world_home_lights={
"type": "float",
"value": 0.0
}
world_night={
"type": "float",
"value": 0.0
}
