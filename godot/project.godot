[rendering]

lights_and_shadows/directional_shadow/size=8192
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.09, 0.427, 0.604, 1)

[shader_globals]

vegetation_time={
"type": "float",
"value": 0.0
}
vegetation_strength={
"type": "float",
"value": 0.8
}
vegetation_direction={
"type": "vec2",
"value": Vector2(0.86, 0.5)
}
world_daylight={
"type": "float",
"value": 1.0
}
world_home_lights={
"type": "float",
"value": 0.0
}
world_night={
"type": "float",
"value": 0.0
}
