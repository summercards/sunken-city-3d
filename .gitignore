# macOS
.DS_Store

# Local agent workspace (memory, logs) - not project source
.workbuddy/

# Preview / verification artifacts
/preview*.png
/preview*.jpg
*.log

# 大体积媒体渲染产物：重新生成即可，不进版本库
/promo/out/
/promo/trailers/
/exports/
/outputs/material-fusion/

# Blender 自动备份（每次保存都会生成 .blend1，重复内容）
*.blend1

# tower_district 美术管线：源文件在 art_source/，下面是渲染中间产物与迭代归档
/outputs/tower_district/cinematic_v009/
/outputs/tower_district/previews/
/outputs/tower_district/source/
/outputs/tower_district/component_migration_v008/

# Godot 移植工程缓存与验收截图
/godot/.godot/
/godot/outputs/

# 水面调参的迭代截图与成片（约 150 MB，用 capture_water_showcase.gd 重生成）
/outputs/ocean-absorption/

# glb 导入时 Godot 解包出来的贴图（源图在 glb 内嵌）
/godot/assets/models/**/*_tex_*.png
/godot/assets/models/**/*_tex_*.png.import

# Godot Web 导出产物（~800MB，用 Godot --export-release 随时重建）
/godot/build/

# Python 字节码
__pycache__/
*.pyc
