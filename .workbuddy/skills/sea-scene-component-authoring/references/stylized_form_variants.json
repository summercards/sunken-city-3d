  "formulas": {
    "rho": "1 - top / bottom",
    "wall_tilt_deg": "atan(abs(rho) * W_base / H_floor)",
    "rho_max_from_tilt": "tan(4deg) * H_floor / W_base",
    "cylinder_rho": "1 - d_top / d_bottom",
    "quoin_short_height": "(H_wall - pairs * gap) / (2.6 * pairs)",
    "brick_rows": "floor(H_visible / block_height)",
    "brick_row_offset": "0.5 * block_length * (row mod 2)",
    "cornice_cap_thickness": "max(0.5 * O, 0.08)",
    "bracket_count": "floor(L / pitch) + 1",
    "pediment_peak": "rise_ratio * L / 2",
    "tower_tank_height": "k * D",
    "tower_leg_height": "0.42 * tank_height",
    "awning_stripe_width": "W_a / stripes",
