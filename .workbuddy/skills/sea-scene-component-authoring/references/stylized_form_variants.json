{
  "schema": "sea.stylized.form",
  "version": "2026-11-09f",
  "status": "planning: 尚无资产按本表制作；在役资产不受影响",
  "units": "metres at final runtime scale; decimals = 1 unless the value is a ratio",
  "scope": "海上主场景中一切可见建筑件；船、独立植物、纯水下远景不适用",
  "reference": {
    "kind": "user reference render 2026-11-09",
    "subject": "城市转角两层店铺：收分红墙+青绿裙墙、转角隅石、三层叠涩檐带单峰山花、屋顶桁架水塔、条纹遮阳篷、成组歪挂件",
    "borrow": [
      "倒梯形反锥",
      "隅石",
      "三层叠涩檐口",
      "单峰山花",
      "桁架锥台水塔",
      "条纹遮阳篷",
      "砖块嵌入",
      "挂件倾斜"
    ],
    "reject": [
      "锈迹色",
      "污渍流挂",
      "暗沉灰调",
      "破损玻璃",
      "街头垃圾堆"
    ]
  },
  "doctrine": {
    "mode": "zero_square",
    "summary": "任何有体量的构件，上下必须不对称。没有默认方正的件，没有整体豁免。",
    "rule": "把这一件单独拎出来，轮廓会读成方盒或直筒吗？会就必须改。",
    "rho_zero": "forbidden",
    "square_count_target": 0,
    "why_not_selective": "上一版'挑 15%-30% 的件'实测只补了两件，剩下全是方盒，整体仍是方块搭的。方盒数量决定观感，风格件数量不决定。",
    "neatness_comes_from": [
      "同族同向：同栋结构族必须同符号",
      "幅度克制：结构族 1%-3%，肉眼几乎不察但消除直筒感",
      "直角不倒置：不做上大下小的墙"
    ],
    "history": {
      "v1": "全件带锥度（ρ 必为 0.02-0.06）—— 幅度过大，整栋锥形",
      "v2": "筛选制（挑 15%-30%）—— 太松，实测只补两件",
      "v3_current": "零方正（每件 1%-10%，无豁免除微件）"
    },
    "flat_axis_rule": {
      "principle": "扁平件的锥度必须施加在平面短边上，长边保持不变",
      "plate_test": "min(extent) < max(extent) / 5",
      "trigger_ratio": 2.0,
      "why": "9.09m 招牌宽收 2% = 18cm，左右边不平行一眼是梯形；同样 2% 放在 2.28m 高度只有 5.7cm，读作手工感",
      "slender_exception": "细长体（柱/杆/梯）：min/middle >= 1/3 且 max/min > 3，变形轴取截面，不是长度",
      "user_reference": "2026-11-09 主招牌截图标注"
    },
    "taper_along_rule": {
      "principle": "锥度沿最长轴渐变，改变的是垂直于它的截面；长边长度不变",
      "formula": "taper_along = argmax(extent); scale = cross-section perpendicular to it",
      "why": "同样 2%，落在截面且摊在最长轴上角度最小。9.09x2.28 招牌：改高度 5.7cm 摊 9m = 0.36°，正确；改宽度 18cm 摊 2.28m = 4.5°，一眼是歪梯形",
      "tie_rule": "最长轴并列（正方平面）时任选，判定为「该轴尺寸等于最大值」",
      "user_reference": "2026-11-09 主招牌截图标注「长短边超过1:2，取短边进行长短变形」"
    }
  },
  "locked_by_building_scale": {
    "note": "以下由 building_scale.json 与 SKILL.md 拥有，本表不得覆盖",
    "keys": [
      "ground_clear_height",
      "ground_floor_to_floor",
      "slab_thickness",
      "main_column_width",
      "bevel_segments",
      "palette",
      "material_roles"
    ]
  },
  "rho": {
    "definition": "rho = 1 - top / bottom",
    "sign": "rho > 0 上小下大(正梯形/收分)；rho < 0 上大下小(倒梯形)",
    "measured_on": "对应边长，不按面积（边长差 10% ≈ 面积差 19%）",
    "axes": [
      "z: 竖向体量",
      "x: 横向面宽",
      "y: 进深"
    ],
    "abs_min": 0.01,
    "abs_max": 0.1,
    "min_readable_note": "1080p / 20m 机位下 6m 宽件 1% ≈ 6cm ≈ 2px，低于 1% 等于没做，判失败"
  },
